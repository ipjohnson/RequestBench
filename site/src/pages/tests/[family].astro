---
// One family of tests: what it measures, and each test's request and the checks on its answer,
// recorded from the test itself so the page cannot describe a request the test does not send.
import Shell from "../../components/Shell.astro";
import TestCase from "../../components/TestCase.astro";
import "../../styles/tests.css";
import { corpusLinks, familiesOf, familyPage, legendOf, readAgainst, type FamilyEntry } from "../../lib/corpus.ts";
import { site } from "../../lib/site.ts";

export function getStaticPaths() {
  const { corpus } = site();
  return (corpus ? familiesOf(corpus.view) : []).map((family) => ({ params: { family: family.name }, props: { family } }));
}

const { family } = Astro.props as { family: FamilyEntry };
const { corpus, factors } = site();
const view = corpus!.view;
const commit = view.bundle.commit;
const { link, payloadHref } = corpusLinks(corpus!);
/** A test on this page by its anchor, and one in another family by its page. */
const hrefOf = (id: string): string => {
  const fam = view.tests[id]?.family ?? id.split(".")[0] ?? "";
  return fam === family.name ? `#${id}` : `${familyPage(fam, "below")}#${id}`;
};
const against = readAgainst(view);
const tests = family.ids.map((id) => ({ id, t: view.tests[id]! }));
const legend = legendOf(tests.map(({ t }) => t));
const comparable = `${family.comparable.charAt(0).toLowerCase()}${family.comparable.slice(1)}`;
---

<Shell
  title={`${family.name} tests · RequestBench`}
  description={family.about}
  footerLeft="github.com/ipjohnson/RequestBench"
  footerLeftHref="../index.html"
  footerRight={`tests at ${commit.slice(0, 12)}`}
>
  <p class="crumb"><a href="../tests.html">&larr; tests</a></p>
  <h1>{family.name}</h1>
  <p class="lede">{family.about}</p>
  <p class="comparable"><strong>Comparable</strong> {comparable}</p>
  {legend.length > 0 && <p class="legend-note">{legend.join(" ")}</p>}

  <div class="scroll testindex">
    <table>
      <thead>
        <tr>
          <th>test</th>
          <th>request</th>
          <th>base</th>
          <th>what differs from the base</th>
        </tr>
      </thead>
      <tbody>
        {
          tests.map(({ id, t }) => (
            <tr>
              <td class="id">
                <a href={`#${id}`}>{id}</a>
                {t.kind !== "performance" && <span class="pill">not measured</span>}
              </td>
              <td class="route">
                <span class="verb">{t.method ?? ""}</span> {t.path ?? ""}
              </td>
              <td class="id">{t.base && <a href={hrefOf(t.base)}>{t.base}</a>}</td>
              <td class="differs">{t.varies && (factors[t.varies] ?? t.varies)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    tests.map(({ id, t }) => (
      <TestCase id={id} t={t} readBy={against.get(id) ?? []} hrefOf={hrefOf} link={link} payloadHref={payloadHref} />
    ))
  }
</Shell>
