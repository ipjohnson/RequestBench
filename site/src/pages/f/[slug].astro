---
// One framework, as one run measured it.
//
// docs/bundles.html §6. Rendered from the bundle manifest at the commit that run recorded
// rather than from the working tree, so a page about a run made in March shows the code that
// ran in March.
import Shell from "../../components/Shell.astro";
import Distribution from "../../components/Distribution.astro";
import EndpointPane from "../../components/EndpointPane.astro";
import "../../styles/framework.css";
import { permalink, type SnippetPart } from "../../lib/bundleview.js";
import { deltaFor } from "../../lib/delta.js";
import { usedSpan } from "../../lib/bins.js";
import { site, type FrameworkPage } from "../../lib/site.js";

export function getStaticPaths() {
  return site().pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: FrameworkPage };
const { run, target: t, rn, view, linkable, repo, commit } = page;
const { wire, routes, factors, projects } = site();

const name = t.framework || t.target;
const facts = [
  `${name} ${t.version || "?"}`,
  t.target_runtime ?? "",
  ...(["adapter", "serializer", "etag", "cache"] as const)
    .filter((k) => t[k])
    .map((k) => `${k} ${t[k]}`),
].filter(Boolean);

/** What the project is and where to read it. Absent for a target nobody has filled in yet. */
const project = projects[`${t.language}:${t.target}`];
const links: [string, string][] = [
  ["source", project?.repo],
  ["docs", project?.docs],
  ["package", project?.package],
].filter((l): l is [string, string] => Boolean(l[1]));
/** github.com/gin-gonic/gin reads better in a cell than the scheme does. */
const trim = (u: string): string => u.replace(/^https:\/\//, "").replace(/\/$/, "");

/** Only for the rate this page opens on, which the Endpoints hint states. */
const row = t.rungs[rn];

const order = run.endpoint_order ?? [];
const own = t.endpoints ?? {};
const snips = view?.snippets ?? {};
const famOf = new Map<string, string>(
  run.targets.flatMap((t2) =>
    Object.entries(t2.endpoints ?? {}).map(([eid, rec]): [string, string] => [eid, rec.family ?? ""]),
  ),
);
const host = run.exec_host || "container";
const exemplars =
  (wire[`${t.language}-${t.target}@${host}`] ?? wire[`${t.language}-${t.target}`])?.endpoints ?? {};

// One registration often answers a whole family. Naming the rest on the pane is what the old
// deduplicated list was protecting: without it the same block appears under six endpoints with
// nothing to say they are one call.
const serves = new Map<string, string[]>();
for (const eid of order) {
  const sn = snips[eid];
  if (!sn) continue;
  const at = `${sn.handler.path}:${sn.handler.start_line}-${sn.handler.end_line}`;
  serves.set(at, [...(serves.get(at) ?? []), eid]);
}
const alsoFor = (eid: string): string[] => {
  const sn = snips[eid];
  if (!sn) return [];
  const h = sn.handler;
  return (serves.get(`${h.path}:${h.start_line}-${h.end_line}`) ?? []).filter((o) => o !== eid);
};

// Wiring is keyed by family, so every endpoint of a family renders the same support parts.
// Naming the rest is what keeps six identical sections from reading as six separate answers.
const wiredWith = (eid: string): string =>
  (snips[eid]?.support ?? []).map((p) => `${p.path}:${p.start_line}-${p.end_line}`).join(" ");
const shares = new Map<string, string[]>();
for (const eid of order) {
  const at = wiredWith(eid);
  if (!snips[eid] || !at) continue;
  shares.set(at, [...(shares.get(at) ?? []), eid]);
}
const alsoWired = (eid: string): string[] =>
  (shares.get(wiredWith(eid)) ?? []).filter((o) => o !== eid);

/** Parts with their own permalinks: they come from other files than the handler. */
const linked = (parts: SnippetPart[]): { part: SnippetPart; link: string | null }[] =>
  parts.map((part) => ({
    part,
    link:
      linkable && repo ? permalink(repo, commit, part.path, part.start_line, part.end_line) : null,
  }));

const groups: [string, string[]][] = [];
for (const eid of order) {
  const fam = own[eid]?.family || famOf.get(eid) || "";
  const last = groups[groups.length - 1];
  if (!last || last[0] !== fam) groups.push([fam, [eid]]);
  else last[1].push(eid);
}

// A summary written before bins existed has none, and one whose target did not complete the
// rate has no histogram to draw. Either way the page renders as it did before rather than an
// empty grid, the same treatment a missing bundle_hash gets above.
const grid = run.bin_grid;

// Every rate the run recorded for this target, not just the one the page opens on. The
// reader flips between them in the browser, so both are rendered and one is shown; fetching
// on demand would be a second data path for a page that is already a static file.
const rates = (run.rungs ?? [])
  .map(String)
  .filter((r) => t.rungs[r])
  .map((r) => ({
    rn: r,
    label: `${(t.rungs[r]?.offered_rps ?? 0).toLocaleString()} rps`,
    span: usedSpan(own, order, r),
    shown: r === rn,
  }));
const hasBins = Boolean(grid) && rates.some((r) => r.span);

const missing = order.filter((e) => !snips[e]);
const note =
  Object.keys(snips).length && missing.length ? ` No handler located for ${missing.join(", ")}.` : "";
const rate = row ? (row.offered_rps ?? 0).toLocaleString() : "?";
const linkFor = (eid: string): string | null => {
  const sn = snips[eid];
  if (!sn || !linkable || !repo) return null;
  return permalink(repo, commit, sn.handler.path, sn.handler.start_line, sn.handler.end_line);
};
---

<Shell
  title={`${name} · RequestBench`}
  footerLeft="github.com/ipjohnson/RequestBench"
  footerLeftHref="../index.html"
  footerRight={`run ${run.run_id}`}
>
  <p class="crumb"><a href="../index.html">&larr; results</a></p>
  <div class="ident">
    <div class="mono-mark">{name[0]?.toUpperCase()}</div>
    <h1>{name}</h1>
  </div>
  <p class="factline">{facts.join(" · ")}</p>
  {
    project && (
      <table class="ident-table">
        <thead>
          <tr>
            <th class="l">project</th>
            <th class="l">licence</th>
            {links.map(([label]) => (
              <th class="l">{label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="l">{name}</td>
            <td class="l">{project.licence ?? "—"}</td>
            {links.map(([, href]) => (
              <td class="l">
                <a href={href}>{trim(href)}</a>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    )
  }

  {
    !order.length ? (
      <div class="note">This run recorded no endpoint order, so there is nothing to explore.</div>
    ) : (
      <div class="panel">
        <h2>Endpoints</h2>
        <p class="hint">
          {order.length} endpoints in {groups.length} families, on the {host} host
          {rates.length > 1 ? ", at the rate picked on the right" : ` at ${rate} offered rps`}.{note}
        </p>
        {hasBins && grid && (
          <div class="eptabs">
            <div role="tablist" aria-label="How to read these endpoints">
              <button type="button" role="tab" id="tab-info" aria-controls="view-info" aria-selected="true">
                Info
              </button>
              <button
                type="button"
                role="tab"
                id="tab-dist"
                aria-controls="view-dist"
                aria-selected="false"
              >
                Distribution
              </button>
            </div>
            {rates.length > 1 && (
              <div class="eprates" role="group" aria-label="Offered rate">
                {rates.map((r) => (
                  <button
                    type="button"
                    class="eprate-pick"
                    data-rung={r.rn}
                    aria-pressed={r.shown}
                  >
                    {r.label}
                  </button>
                ))}
              </div>
            )}
          </div>
        )}
        {hasBins && grid && (
          <div class="epdist" id="view-dist" role="tabpanel" aria-labelledby="tab-dist" hidden>
            <p class="hint">
              Where each endpoint's requests landed, as a share of what that endpoint served.
              The percentiles on its pane are read from this same histogram. Pick a row to open it.
            </p>
            {rates.map((r) => (
              <Distribution grid={grid} groups={groups} endpoints={own} rn={r.rn} shown={r.shown} />
            ))}
          </div>
        )}
        <div class="explorer" id="view-info" role="tabpanel" aria-labelledby="tab-info">
          <nav class="eptree">
            <ul>
              {groups.map(([fam, eids]) => (
                <li class="epfam">
                  <span class="epfamname">{fam}</span>
                  <ul>
                    {eids.map((eid) => (
                      <li>
                        <a
                          class="eplink"
                          href={`#${eid}`}
                          data-ep={eid}
                          aria-current={eid === order[0] ? "true" : undefined}
                        >
                          <span class="epid">{eid}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </nav>
          <div class="eppanes">
            {order.map((eid) => (
              <EndpointPane
                eid={eid}
                route={routes[eid]}
                rungs={rates.map((r) => ({
                  rn: r.rn,
                  stats: own[eid]?.rungs?.[r.rn],
                  chain: deltaFor(t, eid, r.rn, routes, "p50_us"),
                  span: r.span,
                  shown: r.shown,
                }))}
                grid={grid}
                snippet={snips[eid]}
                also={alsoFor(eid)}
                link={linkFor(eid)}
                support={linked(snips[eid]?.support ?? [])}
                tests={linked(snips[eid]?.test ?? [])}
                alsoWired={alsoWired(eid)}
                mechanism={view?.mechanisms[eid.split(".")[0] ?? ""]}
                exchange={exemplars[eid]}
                factors={factors}
                first={eid === order[0]}
              />
            ))}
          </div>
        </div>
      </div>
    )
  }

  <script>
    import { startTree } from "../../client/endpoint-tree.js";
    startTree();
  </script>
</Shell>
