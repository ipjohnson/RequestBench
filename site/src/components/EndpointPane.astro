---
// One endpoint's pane: what it answers, what it cost, the code behind it, what it sent and
// the test that holds it.
import EndpointHistogram from "./EndpointHistogram.astro";
import { baseCell } from "../lib/views.js";
import { cell, type Unit } from "../lib/metrics.js";
import { esc } from "../lib/html.js";
import type { Chain } from "../lib/delta.js";
import type { BinGrid, EndpointRung, Route, WireEndpoint } from "../lib/types.js";
import type { Mechanism, Snippet, SnippetPart } from "../lib/bundleview.js";

/** What this endpoint did at one offered rate. Everything else on the pane is rate-agnostic. */
export type PaneRung = {
  rn: string;
  stats: EndpointRung | undefined;
  /** What the base did at the same rate. */
  base: EndpointRung | undefined;
  /** The comparison on each percentile, keyed by the statistic it was taken on. */
  chains: Readonly<Record<string, Chain | null>>;
  span: { c0: number; c1: number; n: number } | null;
  shown: boolean;
};

type Pct = "p50_us" | "p90_us" | "p95_us" | "p99_us" | "p999_us";

/**
 * One column of the performance table. `base` is null when there is no base row. `m` names
 * the statistic and `n` is its number, which another framework's row is read against.
 */
type Field = {
  k: string;
  m: string;
  n: number | null | undefined;
  v: string;
  title?: string | undefined;
  base: string | null;
};

type Props = {
  eid: string;
  route: Route | undefined;
  rungs: PaneRung[];
  grid: BinGrid | undefined;
  snippet: Snippet | undefined;
  /** Endpoints the same registration answers, so six panes do not each claim the block. */
  also: string[];
  link: string | null;
  /** The parts that make the family work, each with its own permalink. */
  support: { part: SnippetPart; link: string | null }[];
  /** Endpoints the same wiring serves, for the same reason `also` exists. */
  alsoWired: string[];
  /** What spec/matrix.json says this family is wired with in this target. */
  mechanism: Mechanism | undefined;
  /** What holds this target to its contract: its own suite, and its envelope package. */
  tests: { part: SnippetPart; link: string | null }[];
  exchange: WireEndpoint | undefined;
  /** The endpoint this one is compared with, when the run measured it. */
  against: string | null;
  /** The base's captured exchange, for its size. */
  baseExchange: WireEndpoint | undefined;
  /** The captured response body's size against the base's, which no rate changes. */
  size: Chain | null;
  factors: Record<string, string>;
  first: boolean;
};

const { eid, route, rungs, grid, snippet, also, link, support, alsoWired, mechanism, tests,
        exchange, against, baseExchange, size, factors, first } = Astro.props;

const measure = (r: PaneRung): { fields: Field[]; measured: boolean } => {
  const d = r.stats ?? {};
  const b = r.base ?? {};
  // p95 is in summaries written after harness/summarize.py started recording it. An older
  // one carries p90, and the pane says p90 rather than labelling it p95.
  const tail: [string, Pct] = "p95_us" in d ? ["p95", "p95_us"] : ["p90", "p90_us"];
  const under = (v: string, x: Chain | null | undefined, unit: Unit, level: string): string | null =>
    against ? baseCell(v, x, unit, factors, level) : null;
  const pct = ([k, m]: [string, Pct]): Field => ({
    k,
    m,
    n: d[m],
    v: cell(d[m], "us"),
    base: under(cell(b[m], "us"), r.chains[m], "us", k),
  });
  return {
    measured: Object.keys(d).length > 0,
    fields: [
      pct(["p50", "p50_us"]),
      pct(tail),
      pct(["p99", "p99_us"]),
      pct(["p99.9", "p999_us"]),
      {
        k: "size",
        m: "sbz",
        n: exchange?.sbz,
        v: cell(exchange?.sbz, "B"),
        title: exchange && `The response body as the conformance gate captured it. Its headers add ${exchange.shz.toLocaleString()} B.`,
        base: under(cell(baseExchange?.sbz, "B"), size, "B", ""),
      },
      { k: "samples", m: "count", n: d.count, v: cell(d.count), base: under(cell(b.count), null, "", "") },
      ...(["errors", "mismatch"] as const)
        .filter((k) => d[k])
        .map((k): Field => ({ k, m: k, n: d[k], v: cell(d[k]), base: under(cell(b[k]), null, "", "") })),
    ],
  };
};
const h = snippet?.handler;
const loc = h ? `${h.path}:${h.start_line}${h.end_line === h.start_line ? "" : `-${h.end_line}`}` : "";
const where = (p: SnippetPart): string =>
  `${p.path}:${p.start_line}${p.end_line === p.start_line ? "" : `-${p.end_line}`}`;
// The blocks a fragment is nested in, which snippets.py works out so the gate can tell a
// handler from a condition. They are not part of the range, because that is what the
// permalink points at, so they are shown beside it rather than in it.
const context = (h?.context ?? []) as { line: number; text: string }[];
// Only the tests marked for this endpoint by name. A helper marked for the family or the
// target is this benchmark's setup, such as the floor that checks every response's content
// encoding, and most projects would not write it.
const ownTests = tests.filter(
  ({ part }) => ((part as { scope?: string }).scope ?? "endpoint") === "endpoint",
);
// Two kinds of test share the role and are not the same claim. A target's own suite boots
// the target and holds it to spec/expected.json; a client-exception package describes the
// error envelope the framework declares and is run by the conformance client against nothing
// at all. One heading over both would say the wrong thing about whichever came second.
const contract = ownTests.filter(({ part }) => part.path.includes("/client-exception/"));
const suite = ownTests.filter(({ part }) => !part.path.includes("/client-exception/"));
const hdrs = (hs: readonly (readonly [string, string])[]): string =>
  hs
    .map(([k, v]) => `<div class='hrow'><span class='hk'>${esc(k)}</span><span class='hv'>${esc(v)}</span></div>`)
    .join("");
---

<section class="eppane" data-ep={eid} data-base={against ?? undefined} hidden={!first}>
  <h2 class="epname">{eid}</h2>
  <p class="leafroute"><span class="verb">{route?.m ?? ""}</span> {route?.p ?? ""}</p>

  <div class="perfhead">
    <h3 class="childcap">Performance</h3>
    <p class="cmpkey" hidden></p>
  </div>
  {
    rungs.map((r) => {
      const { fields, measured } = measure(r);
      return (
        <div class="eprate" data-rung={r.rn} hidden={!r.shown}>
          {measured ? (
            <div class="fields">
              {fields.map((f) => (
                <div class="frow" data-k={f.m} data-v={f.n ?? undefined}>
                  <span class="fk">{f.k}</span>
                  <span class="fv" title={f.title}>{f.v}</span>
                  {f.base !== null && <Fragment set:html={f.base} />}
                </div>
              ))}
            </div>
          ) : (
            <p class="empty">Not measured at this rate.</p>
          )}
          {grid && r.span && <EndpointHistogram grid={grid} stats={r.stats} span={r.span} eid={eid} />}
        </div>
      );
    })
  }

  <h3 class="childcap">Implementation</h3>
  <div class="parts">
    {
      h ? (
        <>
          <div class="sniphead">
            <span class="loc">{loc}</span>
            <span class="how">{h.how}</span>
            {link && <a href={link}>open on GitHub &rarr;</a>}
          </div>
          {also.length > 0 && (
            <p class="hint">The same registration answers {also.join(", ")}.</p>
          )}
          {context.length > 0 && (
            <div class="ctx">
              {context.map((c) => (
                <div>
                  {c.line}: {c.text}
                </div>
              ))}
            </div>
          )}
          <pre class="code">{h.text}</pre>
        </>
      ) : (
        <p class="empty">No handler located for this endpoint.</p>
      )
    }
    {
      mechanism?.mechanism ? (
        <p class="mech">
          {mechanism.mechanism}
          {mechanism.dep && <> &middot; <code>{mechanism.dep}</code></>}
        </p>
      ) : (
        mechanism?.builtin && <p class="mech">{mechanism.builtin}</p>
      )
    }
    {
      support.map(({ part, link: href }) => (
        <>
          <div class="sniphead">
            <span class="loc">{where(part)}</span>
            <span class="how">{part.how}</span>
            {href && <a href={href}>open on GitHub &rarr;</a>}
          </div>
          <pre class="code">{part.text}</pre>
        </>
      ))
    }
    {
      support.length > 0 && alsoWired.length > 0 && (
        <p class="hint">The same wiring serves {alsoWired.join(", ")}.</p>
      )
    }
  </div>

  <h3 class="childcap">On the wire</h3>
  {
    exchange ? (
      <div class="wirecols">
        <div>
          <h3>Request</h3>
          <pre class="wire req">{exchange.m} {exchange.p}</pre>
          <div class="hdrs" set:html={hdrs(exchange.rh)} />
          {exchange.rb ? (
            <pre class="wire">{exchange.rb}{exchange.rbz > 700 ? `\n… ${exchange.rbz.toLocaleString()} bytes total` : ""}</pre>
          ) : (
            <p class="empty">no body</p>
          )}
        </div>
        <div>
          <h3>Response</h3>
          <pre class="wire res">HTTP {exchange.s}</pre>
          <div class="hdrs" set:html={hdrs(exchange.sh)} />
          {exchange.sb ? (
            <pre class="wire">{exchange.sb}{exchange.tr ? `\n… ${exchange.sbz.toLocaleString()} bytes total` : ""}</pre>
          ) : (
            <p class="empty">no body</p>
          )}
        </div>
      </div>
    ) : (
      <p class="empty">
        No captured exchange for this target. Exemplars are written by <code>make exemplars</code>{" "}
        and only for the targets it has been run against.
      </p>
    )
  }

  {
    ([["Test", suite], ["Contract test", contract]] as const).map(
      ([caption, parts]) =>
        parts.length > 0 && (
          <>
            <h3 class="childcap">{caption}</h3>
            <div class="parts">
              {parts.map(({ part, link: href }) => (
                <>
                  <div class="sniphead">
                    <span class="loc">{where(part)}</span>
                    <span class="how">{part.how}</span>
                    {href && <a href={href}>open on GitHub &rarr;</a>}
                  </div>
                  <pre class="code">{part.text}</pre>
                </>
              ))}
            </div>
          </>
        ),
    )
  }
</section>
