---
// One framework's latency distribution at one rate: a row per test, a column per latency bin.
//
// A row is normalised against its own count, so a cell reads as "this share of what this test
// served", and rows with different counts stay comparable side by side.
//
// A view of one framework. Two of these read against each other is worse than the numbers the
// explorer already publishes, which is why it lives here and not on a comparison page.
import { binEdge, scaleFor, usLabel, usedSpan } from "../lib/bins.ts";
import type { BinGrid, TestRecord } from "../lib/types.ts";
import { esc } from "../lib/html.ts";

type Props = {
  grid: BinGrid;
  /** Test ids in the order the run lists them, already grouped by family. */
  groups: [string, string[]][];
  tests: Record<string, TestRecord>;
  rn: string;
  /** Hidden until its rate is the one picked. */
  shown: boolean;
};
const { grid, groups, tests, rn, shown } = Astro.props as Props;

const CW = 22;
const RH = 15;

const rows = groups.flatMap(([fam, ids], gi) =>
  ids.map((id, i) => ({
    id,
    fam,
    /** A family's first row carries the rule that separates it from the one above. */
    first: i === 0 && gi > 0,
    rung: tests[id]?.rungs?.[rn],
  })),
);

const span = usedSpan(
  tests,
  rows.map((r) => r.id),
  rn,
);

// The names sit where the tree's names sit, so switching tabs moves the grid in beside a list
// that has not moved. 210 is the tree column's own minimum; a framework whose longest id needs
// more than that takes more. IBM Plex Mono is 0.6em to the advance.
const LAB = Math.max(210, Math.ceil(Math.max(...rows.map((r) => r.id.length)) * 11 * 0.6) + 20);

const nc = span?.n ?? 0;
const W = LAB + nc * CW + 14;
const H = 30 + rows.length * RH + 6;
const sc = span ? scaleFor(grid, span.c0, span.c1, LAB, nc * CW) : null;

// Seven steps, so a reader can name a cell's band from the key rather than guess a shade.
const STOPS = [0.5, 2, 5, 12, 25, 50];
const step = (share: number): number => STOPS.findIndex((s) => share < s) + 1 || 7;
---

{
  span && sc && (
    <div class="dist" data-rung={rn} hidden={!shown}>
      <div class="distscroll">
        <svg
          class="distsvg"
          viewBox={`0 0 ${W} ${H}`}
          width={W}
          height={H}
          role="img"
          aria-label={`Latency distribution for ${rows.length} tests. Every value is on the test's own pane.`}
        >
          {sc.decades.map((v) => (
            <Fragment>
              <line x1={sc.x(v)} x2={sc.x(v)} y1={24} y2={H - 6} class="distgrid" />
              <text x={sc.x(v)} y={18} text-anchor="middle" class="disttick">
                {usLabel(v)}
              </text>
            </Fragment>
          ))}
          {rows.map((r, i) => {
            const y = 30 + i * RH;
            const bins = r.rung?.bins ?? [];
            const n = bins.reduce((a, b) => a + b, 0);
            return (
              <Fragment>
                {r.first && <line x1={0} x2={W - 14} y1={y} y2={y} class="distrule" />}
                <a href={`#${encodeURIComponent(r.id)}`} class="distrow" data-ep={r.id}>
                  <rect x={0} y={y} width={W - 14} height={RH} class="disthit" />
                  <rect x={0} y={y + 1} width={2} height={RH - 2} class="distrail" />
                  <text x={2} y={y + RH / 2 + 3.5} class="distlabel">
                    {r.id}
                  </text>
                </a>
                {bins.map((c, j) => {
                  if (!c || j < span.c0 || j > span.c1) return null;
                  const share = (100 * c) / n;
                  const title =
                    `${r.id} · ${usLabel(binEdge(grid, j))}–${usLabel(binEdge(grid, j + 1))} · ` +
                    `${c.toLocaleString()} of ${n.toLocaleString()} requests ` +
                    `(${share < 0.1 ? "<0.1" : share.toFixed(1)}%)`;
                  return (
                    <rect
                      x={LAB + (j - span.c0) * CW + 1}
                      y={y + 1}
                      width={CW - 2}
                      height={RH - 2}
                      rx="1"
                      class={`distcell s${step(share)}`}
                    >
                      <title set:html={esc(title)} />
                    </rect>
                  );
                })}
              </Fragment>
            );
          })}
        </svg>
      </div>
      <p class="distkey">
        <span>Share of the test's own requests</span>
        <span class="distramp">
          {[1, 2, 3, 4, 5, 6, 7].map((s) => (
            <i class={`s${s}`} />
          ))}
        </span>
        <span class="distscale">none · &lt;0.5% · 2 · 5 · 12 · 25 · &ge;50%</span>
      </p>
    </div>
  )
}
