---
// One family's pane: what the family cost as a whole, then each test in it.
//
// A family row in the explorer is this number, so the pane a family row opens on has to show
// it. The tests are listed rather than their panes repeated; each links to its own.
import { cell } from "../lib/metrics.ts";
import { deltaCell } from "../lib/views.ts";
import type { Chain } from "../lib/delta.ts";
import type { FamilyRecord, Route, TestRung } from "../lib/types.ts";

/** What the family and its tests did at one offered rate. */
export type FamilyRung = {
  rn: string;
  stats: FamilyRecord | undefined;
  tests: { id: string; stats: TestRung | undefined; chain: Chain | null }[];
  shown: boolean;
};

type Props = {
  fam: string;
  size: number;
  /** What the corpus says the family is. */
  about: string | undefined;
  /** The family's tests page, with every test's request and expected answer. */
  page: string | null;
  routes: Record<string, Route | undefined>;
  rungs: FamilyRung[];
};

const { fam, size, about, page, routes, rungs } = Astro.props;

// Cut here rather than in CSS: the table is auto-layout, so a max-width on a cell is advisory
// and query.many's eight parameters would widen the whole pane.
const clip = (s: string, n: number): string => (s.length > n ? `${s.slice(0, n - 1)}…` : s);
---

<section class="eppane" data-fam={fam} hidden>
  <h2 class="epname">{fam}</h2>
  {about && <p class="hint">{about}</p>}
  <p class="hint">
    {size} {size === 1 ? "test" : "tests"}. The family's percentiles are read from its tests' histograms merged
    into one.
    {page && (
      <>
        {" "}
        Each test's request and expected answer are on the <a href={page}>{fam} tests page</a>.
      </>
    )}
  </p>

  <div class="perfhead">
    <h3 class="childcap">Performance</h3>
    <p class="cmpkey" hidden></p>
  </div>
  {
    rungs.map((r) => (
      <div class="eprate" data-rung={r.rn} hidden={!r.shown}>
        {r.stats ? (
          <div class="fields">
            {(
              [
                ["p50", "p50Us", "us"],
                ["p90", "p90Us", "us"],
                ["p99", "p99Us", "us"],
                ["p99.9", "p999Us", "us"],
                ["samples", "count", ""],
              ] as const
            ).map(([k, m, unit]) => (
              <div class="frow" data-k={m} data-v={r.stats?.[m] ?? undefined}>
                <span class="fk">{k}</span>
                <span class="fv">{cell(r.stats?.[m], unit)}</span>
              </div>
            ))}
          </div>
        ) : (
          <p class="empty">Not measured at this rate.</p>
        )}
        <h3 class="childcap">Tests</h3>
        <div class="scroll">
          <table class="famtable">
            <thead>
              <tr>
                <th class="l">test</th>
                <th class="l">route</th>
                <th>p50</th>
                <th>p99</th>
                <th title="Against the root of this test's base chain">over base</th>
                <th>samples</th>
              </tr>
            </thead>
            <tbody>
              {r.tests.map((e) => {
                const route = routes[e.id];
                return (
                  <tr>
                    <td class="l">
                      <a class="famep" href={`#${e.id}`} data-ep={e.id}>
                        {e.id}
                      </a>
                    </td>
                    {route ? (
                      <td class="l route" title={`${route.m} ${route.p}`}>
                        <span class="verb">{route.m}</span> {clip(route.p, 44)}
                      </td>
                    ) : (
                      <td class="l route">&mdash;</td>
                    )}
                    <td>{cell(e.stats?.p50Us, "us")}</td>
                    <td>{cell(e.stats?.p99Us, "us")}</td>
                    <Fragment set:html={deltaCell(e.chain, "us")} />
                    <td class="sub">{cell(e.stats?.count)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    ))
  }
</section>
