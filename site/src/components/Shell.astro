---
// The frame every page shares: the fonts, the palette, the tab icons and the footer.
import "../styles/tokens.css";
import "../styles/app.css";
// Imported rather than left in public/, so each link is an /assets/ URL that
// relative-assets.ts makes relative like every other asset.
import appleTouchIcon from "../assets/apple-touch-icon.png?url";
import favicon32 from "../assets/favicon-32.png?url";
import favicon from "../assets/favicon.svg?url";

type Props = {
  title: string;
  description?: string;
  /** Where the browser reads results from, when this build was pointed somewhere. */
  dataBase?: string | null;
  footerLeft: string;
  footerLeftHref?: string;
  footerRight: string;
};

const { title, description, dataBase, footerLeft, footerLeftHref, footerRight } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {dataBase && <meta name="rb:data" content={dataBase} />}
    <link rel="icon" href={favicon32} sizes="32x32" type="image/png" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:wght@400;600&family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="page">
      <slot />
      <footer>
        <span>
          {footerLeftHref ? <a href={footerLeftHref}>{footerLeft}</a> : footerLeft}
        </span>
        <span set:html={footerRight} />
      </footer>
    </div>
  </body>
</html>
