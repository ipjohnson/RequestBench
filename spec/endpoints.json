{
  "version": "blend-v2",
  "sampling": "uniform",
  "note": "Every endpoint is drawn with equal probability. There is no share field: the request stream carries no opinion about traffic, and every opinion lives in a weight vector in spec/blends.json applied when an aggregate is composed. Generators never fill params or headers themselves; they replay spec/plan.json, which harness/plan.py derives from this file and the fixture. 'base' names the endpoint to subtract and 'varies' the single factor that differs from it, which is what lets the site render a delta column. 'correlate' names a strategy that keeps related ids consistent.",
  "fixture": {
    "products": {
      "min": 1,
      "max": 50
    },
    "customers": {
      "min": 1,
      "max": 200
    },
    "orders": {
      "min": 1,
      "max": 1000
    },
    "lines": {
      "min": 1,
      "max": 10
    },
    "regions": [
      "north",
      "south",
      "east",
      "west"
    ],
    "categories": [
      "tools",
      "garden",
      "kitchen",
      "outdoor",
      "office"
    ],
    "statuses": [
      "open",
      "paid",
      "shipped",
      "cancelled"
    ]
  },
  "families": {
    "baseline": {
      "exercises": "dispatch floor, no serialization"
    },
    "json": {
      "exercises": "serializer and response buffering across three size regimes"
    },
    "parameters": {
      "exercises": "router captures with segment depth held constant"
    },
    "authorized": {
      "exercises": "the framework's authorization mechanism, crypto excluded"
    },
    "compressed": {
      "exercises": "outbound gzip: the cost of the wiring declining, the cost of it working, and the small-body threshold"
    },
    "cached": {
      "exercises": "validator headers and the conditional request"
    },
    "body": {
      "exercises": "parser and validator, with size crossed against validation"
    },
    "query": {
      "exercises": "query string parsing and coercion, isolated from any use of the values"
    },
    "headers": {
      "exercises": "eager against lazy construction of the request header map"
    },
    "middleware": {
      "exercises": "per-layer dispatch cost at 0, 4 and 16 no-op layers"
    },
    "domain": {
      "exercises": "application-shaped handler work and the write methods"
    },
    "errors": {
      "exercises": "router miss, handler 404 and parser failure"
    },
    "template": {
      "exercises": "server-side rendering of the same model the json family serializes; not comparable across languages"
    }
  },
  "header_sets": {
    "bearer_ok": {
      "authorization": "Bearer {auth.token}"
    },
    "bearer_wrong": {
      "authorization": "Bearer {auth.wrong_token}"
    },
    "gzip_nocache": {
      "accept-encoding": "gzip",
      "cache-control": "no-cache"
    },
    "identity_nocache": {
      "accept-encoding": "identity",
      "cache-control": "no-cache"
    },
    "revalidate_large": {
      "if-none-match": "{payloads.large.etag}"
    },
    "twenty_seven": {
      "x-rb-h01": "v01",
      "x-rb-h02": "v02",
      "x-rb-h03": "v03",
      "x-rb-h04": "v04",
      "x-rb-h05": "v05",
      "x-rb-h06": "v06",
      "x-rb-h07": "v07",
      "x-rb-h08": "v08",
      "x-rb-h09": "v09",
      "x-rb-h10": "v10",
      "x-rb-h11": "v11",
      "x-rb-h12": "v12",
      "x-rb-h13": "v13",
      "x-rb-h14": "v14",
      "x-rb-h15": "v15",
      "x-rb-h16": "v16",
      "x-rb-h17": "v17",
      "x-rb-h18": "v18",
      "x-rb-h19": "v19",
      "x-rb-h20": "v20",
      "x-rb-h21": "v21",
      "x-rb-h22": "v22",
      "x-rb-h23": "v23",
      "x-rb-h24": "v24",
      "x-rb-h25": "v25",
      "x-rb-h26": "v26",
      "x-rb-h27": "v27"
    }
  },
  "endpoints": [
    {
      "id": "baseline.plaintext",
      "family": "baseline",
      "method": "GET",
      "path": "/plaintext",
      "expect": 200
    },
    {
      "id": "json.small",
      "family": "json",
      "method": "GET",
      "path": "/json/small",
      "expect": 200,
      "payload": "small"
    },
    {
      "id": "json.medium",
      "family": "json",
      "method": "GET",
      "path": "/json/medium",
      "expect": 200,
      "payload": "medium",
      "base": "json.small",
      "varies": "size"
    },
    {
      "id": "json.large",
      "family": "json",
      "method": "GET",
      "path": "/json/large",
      "expect": 200,
      "payload": "large",
      "base": "json.small",
      "varies": "size"
    },
    {
      "id": "parameters.static",
      "family": "parameters",
      "method": "GET",
      "path": "/parameters/static/segment/literal",
      "expect": 200,
      "payload": "small",
      "base": "json.small",
      "varies": "depth"
    },
    {
      "id": "parameters.one",
      "family": "parameters",
      "method": "GET",
      "path": "/parameters/{one}",
      "expect": 200,
      "payload": "small",
      "base": "json.small",
      "varies": "captures"
    },
    {
      "id": "parameters.two",
      "family": "parameters",
      "method": "GET",
      "path": "/parameters/{one}/with-second/{two}",
      "expect": 200,
      "payload": "small",
      "base": "parameters.static",
      "varies": "captures"
    },
    {
      "id": "authorized.allowed",
      "family": "authorized",
      "method": "GET",
      "path": "/authorized/small",
      "expect": 200,
      "payload": "small",
      "headers": "bearer_ok",
      "base": "json.small",
      "varies": "authorization"
    },
    {
      "id": "authorized.denied",
      "family": "authorized",
      "method": "GET",
      "path": "/authorized/small",
      "expect": 403,
      "headers": "bearer_wrong",
      "base": "authorized.allowed",
      "varies": "outcome"
    },
    {
      "id": "compressed.identity_small",
      "family": "compressed",
      "method": "GET",
      "path": "/compressed/small",
      "expect": 200,
      "payload": "small",
      "headers": "identity_nocache",
      "base": "json.small",
      "varies": "compression_wiring"
    },
    {
      "id": "compressed.identity_medium",
      "family": "compressed",
      "method": "GET",
      "path": "/compressed/medium",
      "expect": 200,
      "payload": "medium",
      "headers": "identity_nocache",
      "base": "json.medium",
      "varies": "compression_wiring"
    },
    {
      "id": "compressed.identity_large",
      "family": "compressed",
      "method": "GET",
      "path": "/compressed/large",
      "expect": 200,
      "payload": "large",
      "headers": "identity_nocache",
      "base": "json.large",
      "varies": "compression_wiring"
    },
    {
      "id": "compressed.gzip_small",
      "family": "compressed",
      "method": "GET",
      "path": "/compressed/small",
      "expect": 200,
      "payload": "small",
      "headers": "gzip_nocache",
      "base": "compressed.identity_small",
      "varies": "compression"
    },
    {
      "id": "compressed.gzip_medium",
      "family": "compressed",
      "method": "GET",
      "path": "/compressed/medium",
      "expect": 200,
      "payload": "medium",
      "headers": "gzip_nocache",
      "base": "compressed.identity_medium",
      "varies": "compression"
    },
    {
      "id": "compressed.gzip_large",
      "family": "compressed",
      "method": "GET",
      "path": "/compressed/large",
      "expect": 200,
      "payload": "large",
      "headers": "gzip_nocache",
      "base": "compressed.identity_large",
      "varies": "compression"
    },
    {
      "id": "cached.small",
      "family": "cached",
      "method": "GET",
      "path": "/cached/small",
      "expect": 200,
      "payload": "small",
      "base": "json.small",
      "varies": "validators"
    },
    {
      "id": "cached.medium",
      "family": "cached",
      "method": "GET",
      "path": "/cached/medium",
      "expect": 200,
      "payload": "medium",
      "base": "json.medium",
      "varies": "validators"
    },
    {
      "id": "cached.large",
      "family": "cached",
      "method": "GET",
      "path": "/cached/large",
      "expect": 200,
      "payload": "large",
      "base": "json.large",
      "varies": "validators"
    },
    {
      "id": "cached.revalidate",
      "family": "cached",
      "method": "GET",
      "path": "/cached/large",
      "expect": 304,
      "headers": "revalidate_large",
      "base": "cached.large",
      "varies": "conditional"
    },
    {
      "id": "body.bind_small",
      "family": "body",
      "method": "POST",
      "path": "/body/bind/small",
      "expect": 200,
      "body": "order_small"
    },
    {
      "id": "body.bind_medium",
      "family": "body",
      "method": "POST",
      "path": "/body/bind/medium",
      "expect": 200,
      "body": "order_medium",
      "base": "body.bind_small",
      "varies": "size"
    },
    {
      "id": "body.validate_small",
      "family": "body",
      "method": "POST",
      "path": "/body/validate/small",
      "expect": 200,
      "body": "order_small",
      "base": "body.bind_small",
      "varies": "validation"
    },
    {
      "id": "body.validate_medium",
      "family": "body",
      "method": "POST",
      "path": "/body/validate/medium",
      "expect": 200,
      "body": "order_medium",
      "base": "body.bind_medium",
      "varies": "validation"
    },
    {
      "id": "body.rejected_all",
      "family": "body",
      "method": "POST",
      "path": "/body/validate/small",
      "expect": 422,
      "body": "order_invalid",
      "base": "body.validate_small",
      "varies": "outcome"
    },
    {
      "id": "body.rejected_first",
      "family": "body",
      "method": "POST",
      "path": "/body/validate/first-error",
      "expect": 422,
      "body": "order_invalid",
      "base": "body.rejected_all",
      "varies": "error_contract"
    },
    {
      "id": "query.one",
      "family": "query",
      "method": "GET",
      "path": "/query/one?page={page}",
      "expect": 200,
      "base": "json.small",
      "varies": "query_params"
    },
    {
      "id": "query.many",
      "family": "query",
      "method": "GET",
      "path": "/query/many?page={page}&size={size}&status={status}&category={category}&sort={sort}&q={term}&min_price={minp}&max_price={maxp}",
      "expect": 200,
      "base": "query.one",
      "varies": "query_params"
    },
    {
      "id": "headers.few",
      "family": "headers",
      "method": "GET",
      "path": "/headers",
      "expect": 200,
      "payload": "small",
      "base": "json.small",
      "varies": "route"
    },
    {
      "id": "headers.many",
      "family": "headers",
      "method": "GET",
      "path": "/headers",
      "expect": 200,
      "payload": "small",
      "headers": "twenty_seven",
      "base": "headers.few",
      "varies": "header_count"
    },
    {
      "id": "middleware.none",
      "family": "middleware",
      "method": "GET",
      "path": "/middleware/none",
      "expect": 200,
      "payload": "small",
      "base": "json.small",
      "varies": "route"
    },
    {
      "id": "middleware.four",
      "family": "middleware",
      "method": "GET",
      "path": "/middleware/four",
      "expect": 200,
      "payload": "small",
      "base": "middleware.none",
      "varies": "layers"
    },
    {
      "id": "middleware.sixteen",
      "family": "middleware",
      "method": "GET",
      "path": "/middleware/sixteen",
      "expect": 200,
      "payload": "small",
      "base": "middleware.none",
      "varies": "layers"
    },
    {
      "id": "domain.lookup",
      "family": "domain",
      "method": "GET",
      "path": "/domain/orders/{order}",
      "expect": 200
    },
    {
      "id": "domain.filter",
      "family": "domain",
      "method": "GET",
      "path": "/domain/orders?status={status}&page={page}&size={size}",
      "expect": 200
    },
    {
      "id": "domain.join",
      "family": "domain",
      "method": "GET",
      "path": "/domain/customers/{customer}/summary",
      "expect": 200
    },
    {
      "id": "domain.aggregate",
      "family": "domain",
      "method": "GET",
      "path": "/domain/regions/{region}/report",
      "expect": 200
    },
    {
      "id": "domain.create",
      "family": "domain",
      "method": "POST",
      "path": "/domain/orders",
      "expect": 201,
      "body": "order_small"
    },
    {
      "id": "domain.replace",
      "family": "domain",
      "method": "PUT",
      "path": "/domain/orders/{order}",
      "expect": 200,
      "body": "order_small",
      "base": "domain.create",
      "varies": "method"
    },
    {
      "id": "domain.patch",
      "family": "domain",
      "method": "PATCH",
      "path": "/domain/customers/{customer}",
      "expect": 200,
      "body": "customer_patch"
    },
    {
      "id": "domain.delete",
      "family": "domain",
      "method": "DELETE",
      "path": "/domain/orders/{order}/lines/{line}",
      "expect": 204,
      "correlate": "order_line"
    },
    {
      "id": "errors.not_found",
      "family": "errors",
      "method": "GET",
      "path": "/domain/orders/999999",
      "expect": 404,
      "base": "domain.lookup",
      "varies": "outcome"
    },
    {
      "id": "errors.unmatched",
      "family": "errors",
      "method": "GET",
      "path": "/errors/unmatched",
      "expect": 404
    },
    {
      "id": "errors.malformed",
      "family": "errors",
      "method": "POST",
      "path": "/body/validate/small",
      "expect": 422,
      "body": "malformed",
      "base": "body.rejected_all",
      "varies": "parse_failure"
    },
    {
      "id": "template.small",
      "family": "template",
      "method": "GET",
      "path": "/template/small",
      "expect": 200,
      "payload": "small",
      "base": "json.small",
      "varies": "renderer"
    },
    {
      "id": "template.medium",
      "family": "template",
      "method": "GET",
      "path": "/template/medium",
      "expect": 200,
      "payload": "medium",
      "base": "json.medium",
      "varies": "renderer"
    }
  ],
  "params": {
    "product": {
      "kind": "int_range",
      "from": "fixture.products"
    },
    "customer": {
      "kind": "int_range",
      "from": "fixture.customers"
    },
    "order": {
      "kind": "int_range",
      "from": "fixture.orders"
    },
    "line": {
      "kind": "int_range",
      "from": "fixture.lines"
    },
    "one": {
      "kind": "int_range",
      "min": 1,
      "max": 1000
    },
    "two": {
      "kind": "int_range",
      "min": 1,
      "max": 1000
    },
    "region": {
      "kind": "choice",
      "from": "fixture.regions"
    },
    "category": {
      "kind": "choice",
      "from": "fixture.categories"
    },
    "status": {
      "kind": "choice",
      "from": "fixture.statuses"
    },
    "page": {
      "kind": "int_range",
      "min": 0,
      "max": 20
    },
    "size": {
      "kind": "choice",
      "values": [
        10,
        25,
        50
      ]
    },
    "minp": {
      "kind": "int_range",
      "min": 1,
      "max": 40
    },
    "maxp": {
      "kind": "int_range",
      "min": 41,
      "max": 200
    },
    "term": {
      "kind": "choice",
      "values": [
        "ring",
        "bolt",
        "seed",
        "pan",
        "desk"
      ]
    },
    "sort": {
      "kind": "choice",
      "values": [
        "name",
        "created",
        "total"
      ]
    }
  }
}
