{
  "version": "matrix-v1",
  "warmup_classes": {
    "jit": [
      "java",
      "dotnet"
    ],
    "steady": [
      "go",
      "node",
      "python",
      "rust"
    ]
  },
  "languages": {
    "java": {
      "runtime": "temurin:25",
      "baseline": "bare-netty",
      "frameworks": [
        "spring-boot",
        "quarkus",
        "micronaut",
        "helidon-se",
        "vertx",
        "javalin"
      ],
      "anchor": "spring-boot",
      "implemented": []
    },
    "go": {
      "runtime": "golang:1.25",
      "baseline": "net-http",
      "frameworks": [
        "gin",
        "echo",
        "fiber",
        "chi",
        "gorilla-mux",
        "huma"
      ],
      "anchor": "gin",
      "implemented": [
        "gin",
        "echo"
      ]
    },
    "node": {
      "runtime": "node:24",
      "baseline": "node-http",
      "frameworks": [
        "express",
        "fastify",
        "hono",
        "nestjs-fastify",
        "koa",
        "h3"
      ],
      "anchor": "fastify",
      "implemented": [
        "fastify",
        "express"
      ]
    },
    "python": {
      "runtime": "python:3.13",
      "baseline": "raw-asgi",
      "frameworks": [
        "fastapi",
        "litestar",
        "starlette",
        "django-asgi",
        "flask",
        "sanic"
      ],
      "anchor": "fastapi",
      "implemented": []
    },
    "dotnet": {
      "runtime": "dotnet/sdk:10.0",
      "baseline": "raw-kestrel",
      "frameworks": [
        "minimal-apis",
        "aspnet-mvc",
        "fastendpoints",
        "carter",
        "servicestack",
        "wolverine-http",
        "hardened"
      ],
      "anchor": "minimal-apis",
      "implemented": []
    },
    "rust": {
      "runtime": "rust:1.90",
      "baseline": "hyper",
      "frameworks": [
        "axum",
        "actix-web",
        "rocket",
        "poem",
        "salvo",
        "warp"
      ],
      "anchor": "axum",
      "implemented": []
    }
  },
  "rotation": {
    "note": "Day of week picks the shard; ISO week parity picks the suite.",
    "days": {
      "1": "java",
      "2": "go",
      "3": "node",
      "4": "python",
      "5": "dotnet",
      "6": "rust",
      "7": "anchor"
    },
    "suites": {
      "odd": "blend",
      "even": "capability"
    }
  },
  "note": "'frameworks' is the plan of record. 'implemented' is what actually exists and is what any runner attempts; a shard with an empty list is skipped."
}