{
  "version": "matrix-v1",
  "warmup_classes": {
    "jit": [
      "java",
      "dotnet"
    ],
    "steady": [
      "go",
      "node",
      "python",
      "rust"
    ]
  },
  "languages": {
    "java": {
      "runtime": "temurin:25",
      "baseline": "bare-netty",
      "frameworks": [
        "spring-boot",
        "quarkus",
        "micronaut",
        "helidon-se",
        "vertx",
        "javalin"
      ],
      "anchor": "spring-boot",
      "implemented": []
    },
    "go": {
      "runtime": "golang:1.26",
      "baseline": "net-http",
      "frameworks": [
        "gin",
        "echo",
        "fiber",
        "chi",
        "gorilla-mux",
        "huma"
      ],
      "anchor": "gin",
      "implemented": [
        "gin",
        "echo",
        "chi",
        "gorilla-mux",
        "fiber"
      ]
    },
    "node": {
      "runtime": "node:24",
      "baseline": "node-http",
      "frameworks": [
        "express",
        "fastify",
        "hono",
        "nestjs-fastify",
        "koa",
        "h3"
      ],
      "anchor": "fastify",
      "implemented": [
        "fastify",
        "express",
        "hono",
        "koa",
        "h3"
      ]
    },
    "python": {
      "runtime": "python:3.13",
      "baseline": "raw-asgi",
      "frameworks": [
        "fastapi",
        "litestar",
        "starlette",
        "django-asgi",
        "flask",
        "sanic"
      ],
      "anchor": "fastapi",
      "implemented": []
    },
    "dotnet": {
      "runtime": "dotnet/sdk:10.0",
      "baseline": "raw-kestrel",
      "frameworks": [
        "minimal-apis",
        "aspnet-mvc",
        "fastendpoints",
        "carter",
        "servicestack",
        "wolverine-http",
        "hardened"
      ],
      "anchor": "minimal-apis",
      "implemented": []
    },
    "rust": {
      "runtime": "rust:1.90",
      "baseline": "hyper",
      "frameworks": [
        "axum",
        "actix-web",
        "rocket",
        "poem",
        "salvo",
        "warp"
      ],
      "anchor": "axum",
      "implemented": []
    }
  },
  "rotation": {
    "note": "Day of week picks the shard; ISO week parity picks the suite.",
    "days": {
      "1": "java",
      "2": "go",
      "3": "node",
      "4": "python",
      "5": "dotnet",
      "6": "rust",
      "7": "anchor"
    },
    "suites": {
      "odd": "blend",
      "even": "capability"
    }
  },
  "note": "'frameworks' is the plan of record. 'implemented' is what actually exists and is what any runner attempts; a shard with an empty list is skipped.",
  "hosts": {
    "container": {
      "runs": "the framework's own server",
      "languages": [
        "java",
        "go",
        "node",
        "python",
        "dotnet",
        "rust"
      ],
      "note": "The Cloud Run container contract: listen on $PORT and speak HTTP. The same contract covers Fargate, ECS, EKS and plain Docker, so this host is not specific to one cloud."
    },
    "gcp-func": {
      "runs": "GCP Functions Framework",
      "languages": [
        "java",
        "go",
        "node",
        "python",
        "dotnet"
      ],
      "note": "Cloud Run functions. Gen2 functions are Cloud Run underneath, so the same code deployed as a Cloud Run container skips the Functions Framework entirely and runs on the container contract measured here.",
      "compare_to": "container"
    },
    "lambda-rie": {
      "runs": "AWS Runtime Interface Emulator",
      "languages": [
        "java",
        "go",
        "node",
        "python",
        "dotnet",
        "rust"
      ],
      "note": "A genuinely different invocation model: no HTTP in the process, one invocation at a time, so it runs the serial suite rather than a rate ladder."
    },
    "azure-func": {
      "runs": "Azure Functions Core Tools",
      "languages": [
        "java",
        "node",
        "python",
        "dotnet"
      ]
    }
  },
  "hosts_implemented": {
    "node": [
      "container",
      "gcp-func",
      "lambda-rie"
    ],
    "go": [
      "container",
      "gcp-func",
      "lambda-rie"
    ]
  },
  "host_exceptions": {
    "go:fiber": {
      "excluded": [
        "gcp-func",
        "lambda-rie"
      ],
      "why": "fasthttp, not an http.Handler"
    }
  }
}