<!doctype html>
<html>
  <head><title>items</title></head>
  <body>
    <h1>{{.Size}}</h1>
    <table>
      <thead>
        <tr><th>id</th><th>name</th><th>category</th><th>price</th><th>stock</th></tr>
      </thead>
      <tbody>
        {{range .Items}}
        <tr>
          <td>{{.ID}}</td>
          <td>{{.Name}}</td>
          <td>{{.Category}}</td>
          <td>{{.PriceCents}}</td>
          <td>{{if .InStock}}yes{{else}}no{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    <p>{{.Count}} rows</p>
  </body>
</html>
