<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.requestbench</groupId>
    <artifactId>javalin</artifactId>
    <version>0.0.0</version>
  </parent>

  <artifactId>implementation</artifactId>

  <properties>
    <!-- The class the jar starts, which a host's profile can change. -->
    <start.class>implementation.Application</start.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
    </dependency>
    <!-- Javalin's default JSON mapper, JavalinJackson, is Jackson 2, which Javalin leaves to the
         application to add. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin-rendering-mustache</artifactId>
    </dependency>
    <!-- The logger Javalin's documentation adds. Javalin logs through SLF4J and brings no binding. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
    <!-- The @OpenApi annotations. They describe the handlers for the document the client profile
         writes, nothing reads them at run time, and provided keeps them out of the jar. -->
    <dependency>
      <groupId>io.javalin.community.openapi</groupId>
      <artifactId>openapi-specification</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- One jar with every dependency in it, as Javalin's Docker tutorial builds it. It goes beside
           the plain jar, under the exec classifier, because UnitTests compiles against the plain one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>exec</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${start.class}</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- container-h2's build: Jetty's HTTP/2 module, and H2c from container-h2/, which the jar
         starts. The other hosts' builds leave both out. -->
    <profile>
      <id>container-h2</id>
      <properties>
        <start.class>implementation.H2c</start.class>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.jetty.http2</groupId>
          <artifactId>jetty-http2-server</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>container-h2</id>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>${project.basedir}/../container-h2</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- mvn -Pclient compiles with javalin-openapi's annotation processor, which writes the document
         the @OpenApi annotations describe, and copies it to Client/openapi.json. The processor is in
         this profile alone, so the image, which is built without it, does not change. -->
    <profile>
      <id>client</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>io.javalin.community.openapi</groupId>
                  <artifactId>openapi-annotation-processor</artifactId>
                  <version>${javalin-openapi.version}</version>
                </path>
              </annotationProcessorPaths>
              <compilerArgs>
                <arg>-Aopenapi.info.title=Javalin</arg>
                <arg>-Aopenapi.info.version=${project.version}</arg>
              </compilerArgs>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>document</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <copy file="${project.build.outputDirectory}/openapi-plugin/openapi-default.json"
                          tofile="${project.basedir}/../Client/openapi.json" overwrite="true"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
