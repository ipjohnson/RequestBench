<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.requestbench</groupId>
    <artifactId>helidon-se</artifactId>
    <version>0.0.0</version>
  </parent>

  <artifactId>implementation</artifactId>

  <properties>
    <mainClass>implementation.Main</mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.http.media</groupId>
      <artifactId>helidon-http-media-json-binding</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.json</groupId>
      <artifactId>helidon-json-binding</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.http.media</groupId>
      <artifactId>helidon-http-media-multipart</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.validation</groupId>
      <artifactId>helidon-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.security.providers</groupId>
      <artifactId>helidon-security-providers-header</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver-cors</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.http.encoding</groupId>
      <artifactId>helidon-http-encoding-gzip</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver-sse</artifactId>
    </dependency>
    <dependency>
      <groupId>io.helidon.webserver</groupId>
      <artifactId>helidon-webserver-static-content</artifactId>
    </dependency>
    <!-- Helidon SE has no view layer, so the template engine is a dependency of its own. -->
    <dependency>
      <groupId>org.thymeleaf</groupId>
      <artifactId>thymeleaf</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <!-- container-h2's build. The WebServer finds Helidon's HTTP/2 module on the classpath and answers
         HTTP/2 with prior knowledge, and container-h1's build leaves it off. -->
    <profile>
      <id>container-h2</id>
      <dependencies>
        <dependency>
          <groupId>io.helidon.webserver</groupId>
          <artifactId>helidon-webserver-http2</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <plugins>
      <!-- Helidon's annotation processors write the JSON converters for @Json.Entity records and the
           validators for @Validation.Validated ones, and register both with the service registry.
           Both APIs are preview in Helidon 4.5, and each generated file would warn of it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-Ahelidon.api.preview=ignore</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>io.helidon.bundles</groupId>
              <artifactId>helidon-bundles-apt</artifactId>
              <version>${helidon.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- The parent's copy-libs puts every runtime dependency in target/libs, which the jar's
           manifest names on its class path, as Helidon's SE quickstart packages an application. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-libs</id>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
