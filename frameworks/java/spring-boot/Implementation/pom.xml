<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.requestbench</groupId>
    <artifactId>spring-boot</artifactId>
    <version>0.0.0</version>
  </parent>

  <artifactId>implementation</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The executable jar goes beside the plain one, under the exec classifier, because
           repackage otherwise replaces the jar UnitTests compiles against. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- lambda-emulator's build: aws-serverless-java-container, and StreamLambdaHandler from
         lambda-emulator/, which hands the application each event. The other hosts' builds leave
         both out. -->
    <profile>
      <id>lambda-emulator</id>
      <dependencies>
        <dependency>
          <groupId>com.amazonaws.serverless</groupId>
          <artifactId>aws-serverless-java-container-springboot4</artifactId>
          <version>3.0.2</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>lambda-emulator</id>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>${project.basedir}/../lambda-emulator</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- mvn -Pclient verify starts the application, reads the document springdoc serves, and
         writes it to Client/openapi.json. springdoc is in this profile alone, so the image, which
         is built without it, does not change. -->
    <profile>
      <id>client</id>
      <properties>
        <client.port>18080</client.port>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.springdoc</groupId>
          <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
          <version>3.1.1</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>document-start</id>
                <goals>
                  <goal>start</goal>
                </goals>
                <configuration>
                  <!-- Pretty and ordered, so the committed document reads as a diff. The controllers
                       name no content type for their JSON answers, which springdoc writes as */*
                       and Kiota reads as bytes, so the document says application/json. -->
                  <arguments>
                    <argument>--server.port=${client.port}</argument>
                    <argument>--springdoc.writer-with-default-pretty-printer=true</argument>
                    <argument>--springdoc.writer-with-order-by-keys=true</argument>
                    <argument>--springdoc.default-produces-media-type=application/json</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>document-stop</id>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-maven-plugin</artifactId>
            <version>1.5</version>
            <executions>
              <execution>
                <id>document</id>
                <goals>
                  <goal>generate</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <apiDocsUrl>http://localhost:${client.port}/v3/api-docs</apiDocsUrl>
              <outputDir>${project.basedir}/../Client</outputDir>
              <outputFileName>openapi.json</outputFileName>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
