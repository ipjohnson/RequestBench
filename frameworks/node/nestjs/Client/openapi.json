            "minimum": 1
          },
          "qty": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "productId",
          "qty"
        ]
      },
      "CheckedOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "number",
            "minimum": 1
          },
          "status": {
            "type": "string"
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckedLine"
            }
          }
        },
        "required": [
          "customerId",
          "status",
          "lines"
        ]
      },
      "NewItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "priceCents": {
            "type": "number"
          },
          "inStock": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "category",
          "priceCents",
          "inStock"
        ]
      },
      "UpdateItem": {
        "type": "object",
        "properties": {}
      },
      "Search": {
