{
  // The compiler options of Nest's starter. Nest's dependency injection reads the constructor
  // parameter types that emitDecoratorMetadata writes, so the source is compiled rather than run
  // with its types stripped, as the other Node frameworks here run.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["Implementation", "container-h1", "container-h2", "lambda-emulator", "UnitTests", "Client"]
}
