{
  "name": "rb-koa",
  "private": true,
  "type": "module",
  "comment": "Its own package and lockfile, never a workspace of the repository's, so the versions /__meta reports are the ones this lockfile resolved. The source is TypeScript that Node runs as it is, so there is no build step and tsc only checks it. The scripts pass --experimental-strip-types because Node 22 needs it. Node 26, which the image runs, accepts it.",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning container-h1/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"UnitTests/*.test.ts\""
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/ejs": "^5.1.0",
    "@koa/etag": "^5.0.2",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^15.7.0",
    "@koa/send": "^6.0.0",
    "koa": "^3.2.1",
    "koa-cash": "^5.0.2",
    "koa-compress": "^5.2.2",
    "koa-conditional-get": "^3.0.0",
    "koa-parameter": "^3.0.1",
    "lru-cache": "^11.5.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__ejs": "^5.1.1",
    "@types/koa__multer": "^2.0.8",
    "@types/koa-cash": "^4.1.4",
    "@types/koa-conditional-get": "^2.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2"
  }
}
