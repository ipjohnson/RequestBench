<Project Sdk="Microsoft.NET.Sdk">
  <!-- What `dotnet new xunit` writes on the pinned SDK, without the coverage collector, plus
       Microsoft.AspNetCore.Mvc.Testing, the test host ASP.NET Core's MVC documentation uses. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Implementation/Implementation.csproj" />
    <ProjectReference Include="../Client/Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>
</Project>
