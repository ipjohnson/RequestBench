<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Cleared first, so a feed the machine has configured never takes part in a restore.
       The target has to resolve the same packages from the same place on a laptop, in CI
       and in the container. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
