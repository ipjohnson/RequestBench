<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- dotnet build writes the OpenAPI document to Client/openapi.json. Writing it runs Program.cs,
       which needs the payloads, so a build with no RB_PAYLOADS, such as the image's, skips it. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>../Client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocuments Condition="'$(RB_PAYLOADS)' == ''">false</OpenApiGenerateDocuments>
  </PropertyGroup>
  <!-- lambda-emulator publishes this project natively with PublishAot, for linux-x64 or
       linux-arm64, from a restore locked to packages.lock.json like every other host's. So every
       restore resolves the ILCompiler and ILLink packages PublishAot adds, for both architectures.
       PublishAot is set only while restoring, so every other build and publish stays JIT-compiled.
       Without UseDefaultPublishRuntimeIdentifier the restore would add the machine's own runtime,
       and the lock file would differ between machines. -->
  <PropertyGroup Condition="'$(MSBuildIsRestoring)' == 'true'">
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- lambda-emulator's adapter, with Amazon.Lambda.RuntimeSupport as its runtime client. It does
         nothing outside Lambda, so every host builds with it. -->
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
