<Project Sdk="Microsoft.NET.Sdk">
  <!-- What `dotnet new xunit` writes on the pinned SDK, without the coverage collector, plus
       ASP.NET Core's test host. Carter ships no test package of its own. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Implementation/Implementation.csproj" />
    <ProjectReference Include="../Client/Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>
</Project>
