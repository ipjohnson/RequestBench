<Project Sdk="Microsoft.NET.Sdk">
  <!-- What Hardened's hardened-web template writes for its tests: [ModuleTest] on xunit.v3 4.x,
       requests through the pipeline in process, and a Kestrel socket for the rows a server
       frames. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hardened.Shared.Testing" />
    <PackageReference Include="DependencyModules.xUnit4" />
    <PackageReference Include="Hardened.Web.Testing" />
    <PackageReference Include="Hardened.Web.Kestrel.Testing" />
    <PackageReference Include="Hardened.Kiota.Testing" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <!-- The library, not a host: the tests build the library module. -->
    <ProjectReference Include="../Implementation/Implementation.csproj" />
    <ProjectReference Include="../Client/Client.csproj" />
  </ItemGroup>
</Project>
