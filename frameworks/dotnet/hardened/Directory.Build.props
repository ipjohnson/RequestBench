<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A restore writes packages.lock.json beside each project, and a locked restore holds
         the build to it, so the version /__meta reports keeps describing the binary. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Hardened's generators write the routing table, the binders and the module registrations
         as C#, under obj/<configuration>/<tfm>/generated/. The template keeps them on disk to read. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
</Project>
