<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- dotnet build writes the OpenAPI document to Client/openapi.json. Writing it runs Program.cs,
       which needs the payloads, so a build with no RB_PAYLOADS, such as the image's, skips it. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>../Client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerateDocuments Condition="'$(RB_PAYLOADS)' == ''">false</OpenApiGenerateDocuments>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WolverineFx.Http" Version="6.39.1" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.39.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
