<Project Sdk="Microsoft.NET.Sdk">
  <!-- Alba, which Wolverine's documentation names for HTTP tests, over what `dotnet new xunit` writes
       on the pinned SDK, without the coverage collector. Alba asks for ASP.NET Core's test host at
       10.0.0 or later, so it is named here to keep it at the runtime's patch. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Alba" Version="8.5.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Implementation/Implementation.csproj" />
    <ProjectReference Include="../Client/Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Alba" />
    <Using Include="System.Net" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>
</Project>
