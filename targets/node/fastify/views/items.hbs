<!doctype html>
<html>
  <head><title>items</title></head>
  <body>
    <h1>{{size}}</h1>
    <table>
      <thead>
        <tr><th>id</th><th>name</th><th>category</th><th>price</th><th>stock</th></tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{id}}</td>
          <td>{{name}}</td>
          <td>{{category}}</td>
          <td>{{price_cents}}</td>
          <td>{{#if in_stock}}yes{{else}}no{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <p>{{count}} rows</p>
  </body>
</html>
