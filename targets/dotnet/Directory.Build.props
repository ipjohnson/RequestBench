<Project>
  <!-- Every target in the language builds the same way, so the settings live here rather
       than in six csproj files that could drift apart. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Measurement, not development. Without this every target is compared while carrying
         debug assertions, which measures the configuration rather than the framework. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A restore writes packages.lock.json beside the project, and the container build
         restores in locked mode against it. Without that a rebuild months later can
         resolve something newer and the version /__meta reports stops describing the
         binary. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Each framework's error contract sits in client-exception/ beside its project. It is
         TypeScript read by the conformance client, and the Web SDK's default Content globs
         would otherwise publish its package.json and tsconfig.json with the target. The
         suite and the generated client sit beside it for the same reason and are excluded
         for a sharper one: suite/ is C# the Web SDK would compile into the target, which
         would put xunit in the measured binary. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);client-exception/**;suite/**;client/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
