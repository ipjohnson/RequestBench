<Project>
  <!-- One resolution for all six targets, so a difference between two of them is the
       framework rather than a transitive dependency one happened to pick up. That is the
       same reason the Rust targets share one Cargo.lock and the Python targets one
       requirements.txt. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- What the shared domain takes: a service collection to register itself into, and
         nothing that knows what HTTP is. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!-- The six frameworks. -->
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <!-- FastEndpoints' own source generator, for its reflection cache: the object factories,
         property setters and value parsers its binder would otherwise compile from
         expression trees at runtime. Only the analyzer runs. The serializer-context part,
         which installs a CLI tool, stays off. -->
    <PackageVersion Include="FastEndpoints.Generator" Version="8.3.0" />
    <PackageVersion Include="Carter" Version="10.0.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.38.0" />
    <!-- Wolverine 6 compiles its handlers rather than reflecting over them, and core no
         longer ships the compiler. The alternative is committing generated code and
         regenerating it whenever a route moves; this pays Roslyn once at startup instead,
         which the warmup absorbs and which never touches a measured request. A production
         deployment would pre-generate and set TypeLoadMode.Static. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.38.0" />
    <!-- Wolverine's own validation integration: middleware that runs a FluentValidation
         validator on the request before the endpoint, so no endpoint calls one. -->
    <PackageVersion Include="WolverineFx.Http.FluentValidation" Version="6.38.0" />
    <!-- Carter 10 ships no validation of its own, so it takes FluentValidation directly.
         Already resolved transitively by Carter and FastEndpoints; pinned here so all three
         run the same version and a difference between them is the framework. -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the suites take, and nothing a target runs. `dotnet new xunit` on the pinned
         SDK writes these three versions, so they are what the language recommends rather
         than what this repository would have picked. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- FastEndpoints.Testing 8.3.0 depends on xunit.v3, so the one target that takes its
         framework's own test package takes a different xunit major than `dotnet new xunit`
         writes. That is the cost of the package rather than a choice made here, and it is
         recorded rather than smoothed over by putting all five on one runner. -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- The test host each target's own documentation reaches for first. Three of the five
         share WebApplicationFactory; fastendpoints and wolverine-http ship their own, and
         that difference is the thing the suites are here to show. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="FastEndpoints.Testing" Version="8.3.0" />
    <PackageVersion Include="Alba" Version="8.5.3" />
  </ItemGroup>
</Project>
