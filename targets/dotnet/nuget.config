<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear first, so whatever feeds the machine has configured do not reach this restore.
       A target has to resolve the same package from the same place on a laptop and in the
       container, and central package management refuses to run against an ambiguous set of
       sources anyway. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
