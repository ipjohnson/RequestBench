<Project Sdk="Microsoft.NET.Sdk">
  <!-- The lookup every .NET suite shares, and nothing else. A suite's arrange and act are
       written per framework, because the difference between them is what the suites are
       for; the floor assertion is a read out of spec/expected.json, and five copies of a
       read would be five chances to drift away from the file that decides what a correct
       answer is.

       Outside every target's bundle on purpose. harness/bundle.py resolves a target from
       targets/dotnet/<target>, _shared, _hosts and the files sitting directly in
       targets/dotnet, so nothing here is hashed or rendered. What a reader wants on the
       page is the test, which lives beside the handler it tests. -->
  <PropertyGroup>
    <RootNamespace>RequestBench.Suite</RootNamespace>
    <AssemblyName>RequestBench.Suite</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
