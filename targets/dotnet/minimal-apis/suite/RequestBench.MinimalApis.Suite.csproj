<Project Sdk="Microsoft.NET.Sdk">
  <!-- `dotnet new xunit` on the pinned SDK, plus Microsoft.AspNetCore.Mvc.Testing, which is
       what the ASP.NET Core integration-testing documentation reaches for first. Nothing
       else: the point of the suite is what this target's own recommended path costs, and a
       nicer assertion library would measure the library. -->
  <PropertyGroup>
    <RootNamespace>RequestBench.MinimalApis.Suite</RootNamespace>
    <AssemblyName>RequestBench.MinimalApis.Suite</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RequestBench.MinimalApis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
