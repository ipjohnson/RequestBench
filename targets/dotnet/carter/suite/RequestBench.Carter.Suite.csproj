<Project Sdk="Microsoft.NET.Sdk">
  <!-- `dotnet new xunit` on the pinned SDK, plus Microsoft.AspNetCore.Mvc.Testing. Nothing
       else: the point of the suite is what this target's own recommended path costs. -->
  <PropertyGroup>
    <RootNamespace>RequestBench.CarterTarget.Suite</RootNamespace>
    <AssemblyName>RequestBench.Carter.Suite</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RequestBench.Carter.csproj" />
    <ProjectReference Include="../../suite/shared/RequestBench.Suite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
