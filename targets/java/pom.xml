<?xml version="1.0" encoding="UTF-8"?>
<!--
  RequestBench Java targets.

  Every framework version lives in <properties> below and nowhere else. That block is what
  `mvn versions:update-properties` rewrites in the nightly deps job, and what the filtered
  rb-versions.properties carries into /__meta, so a version that moves shows up on the
  trend chart instead of moving numbers invisibly.

  Behaviour is shared, wiring is not: every target depends on rb-shared for the domain and
  differs only in how it binds routes to it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.requestbench</groupId>
  <artifactId>rb-java</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>RequestBench Java targets</name>

  <modules>
    <module>shared</module>
    <module>hosts</module>
    <module>javalin</module>
    <module>vertx</module>
    <module>helidon-se</module>
    <module>spring-boot</module>
    <module>micronaut</module>
    <module>quarkus</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Spring, Micronaut and Quarkus all bind path variables and query parameters by
         their declared name. Without this the name is not in the class file and every
         parameterised route fails at runtime, not at build time. -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!-- Frameworks. The deps job moves these, patch and minor only. -->
    <netty.version>4.2.18.Final</netty.version>
    <javalin.version>7.2.3</javalin.version>
    <vertx.version>5.1.8</vertx.version>
    <helidon.version>4.5.4</helidon.version>
    <spring-boot.version>4.1.1</spring-boot.version>
    <micronaut.version>5.1.5</micronaut.version>
    <quarkus.version>3.39.3</quarkus.version>

    <!-- Shared, so the serializer library is the same everywhere and only each
         framework's integration with it differs. -->
    <jackson.version>2.22.2</jackson.version>

    <!-- Host adapters. These move a target's numbers with the framework version
         unchanged, which is why /__meta names them separately. -->
    <gcp-functions.version>2.0.2</gcp-functions.version>
    <aws-lambda-core.version>1.4.0</aws-lambda-core.version>
    <aws-lambda-events.version>3.16.1</aws-lambda-events.version>
    <aws-serverless-container.version>3.0.2</aws-serverless-container.version>

    <!-- Build plugins. Dependabot does not see these, so the deps job keeps them too. -->
    <shade-plugin.version>3.6.1</shade-plugin.version>
    <versions-plugin.version>2.22.0</versions-plugin.version>
  </properties>

  <!--
    Only what rb-shared and rb-hosts need is managed here. A framework's own BOM lives in
    that framework's module: importing them all in one place lets one framework dictate
    another's transitive versions, which is what happened when the Vert.x 5 BOM reached
    Quarkus and broke its build against the Vert.x 4 it expects.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>io.javalin</groupId>
        <artifactId>javalin</artifactId>
        <version>${javalin.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.cloud.functions</groupId>
        <artifactId>functions-framework-api</artifactId>
        <version>${gcp-functions.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amazonaws</groupId>
        <artifactId>aws-lambda-java-core</artifactId>
        <version>${aws-lambda-core.version}</version>
      </dependency>
      <dependency>
        <groupId>com.amazonaws</groupId>
        <artifactId>aws-lambda-java-events</artifactId>
        <version>${aws-lambda-events.version}</version>
      </dependency>

      <dependency>
        <groupId>dev.requestbench</groupId>
        <artifactId>rb-shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.requestbench</groupId>
        <artifactId>rb-hosts</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions-plugin.version}</version>
          <configuration>
            <!--
              Which artifact each pin tracks, stated rather than inferred.

              versions:update-properties links a property to a dependency by finding it
              used as a <version> in the same project. Every framework BOM is imported in
              its own module, not here, so five of these seven resolve to nothing and the
              nightly deps job would leave them at whatever they were, silently. Checked by
              downgrading a pin and confirming the job brings it back.
            -->
            <!--
              Releases only. Left to itself the plugin took spring-boot to 4.2.0-M1: a
              milestone would land in the nightly measurement overnight and the series
              would show a step nobody chose.
            -->
            <ignoredVersions>
              <ignoredVersion>(?i).*[.-]M\d+</ignoredVersion>
              <ignoredVersion>(?i).*[.-]RC\d*</ignoredVersion>
              <ignoredVersion>(?i).*[.-]CR\d*</ignoredVersion>
              <ignoredVersion>(?i).*[.-]alpha.*</ignoredVersion>
              <ignoredVersion>(?i).*[.-]beta.*</ignoredVersion>
              <ignoredVersion>(?i).*[.-]preview.*</ignoredVersion>
              <ignoredVersion>(?i).*-SNAPSHOT</ignoredVersion>
            </ignoredVersions>
            <properties>
            <property>
              <name>netty.version</name>
              <dependencies>
                <dependency>
                  <groupId>io.netty</groupId>
                  <artifactId>netty-bom</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>javalin.version</name>
              <dependencies>
                <dependency>
                  <groupId>io.javalin</groupId>
                  <artifactId>javalin</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>vertx.version</name>
              <dependencies>
                <dependency>
                  <groupId>io.vertx</groupId>
                  <artifactId>vertx-stack-depchain</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>helidon.version</name>
              <dependencies>
                <dependency>
                  <groupId>io.helidon</groupId>
                  <artifactId>helidon-bom</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>spring-boot.version</name>
              <dependencies>
                <dependency>
                  <groupId>org.springframework.boot</groupId>
                  <artifactId>spring-boot-dependencies</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>micronaut.version</name>
              <dependencies>
                <dependency>
                  <groupId>io.micronaut.platform</groupId>
                  <artifactId>micronaut-platform</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>quarkus.version</name>
              <dependencies>
                <dependency>
                  <groupId>io.quarkus</groupId>
                  <artifactId>quarkus-bom</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>jackson.version</name>
              <dependencies>
                <dependency>
                  <groupId>com.fasterxml.jackson</groupId>
                  <artifactId>jackson-bom</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>gcp-functions.version</name>
              <dependencies>
                <dependency>
                  <groupId>com.google.cloud.functions</groupId>
                  <artifactId>functions-framework-api</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>aws-lambda-core.version</name>
              <dependencies>
                <dependency>
                  <groupId>com.amazonaws</groupId>
                  <artifactId>aws-lambda-java-core</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>aws-lambda-events.version</name>
              <dependencies>
                <dependency>
                  <groupId>com.amazonaws</groupId>
                  <artifactId>aws-lambda-java-events</artifactId>
                </dependency>
              </dependencies>
            </property>
            <property>
              <name>aws-serverless-container.version</name>
              <dependencies>
                <dependency>
                  <groupId>com.amazonaws.serverless</groupId>
                  <artifactId>aws-serverless-java-container-springboot4</artifactId>
                </dependency>
              </dependencies>
            </property>
            </properties>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
