<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.requestbench</groupId>
    <artifactId>rb-java</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>rb-quarkus</artifactId>
  <name>RequestBench target: Quarkus</name>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The suite in src/test: what code.quarkus.io writes for a 3.39 project, quarkus-junit
         (no longer quarkus-junit5) and REST Assured. Test scope, so none of it reaches the
         runner jar. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.requestbench</groupId>
      <artifactId>rb-shared</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.requestbench</groupId>
      <artifactId>rb-hosts</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- Qute, Quarkus's own templating and the only engine it ships. quarkus-rest-qute is
         what lets a JAX-RS method return a TemplateInstance. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-qute</artifactId>
    </dependency>
    <!-- Hibernate Validator, which is what @Valid on a resource method parameter runs.
         Quarkus does not pull it in with the REST extension: validating is opt-in. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-validator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>server</finalName>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <!-- What a generated project gets for its tests. -->
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The surefire configuration code.quarkus.io writes, plus the fixture. @QuarkusTest
           fires the StartupEvent this target loads its fixture on, so unlike the other five
           it needs nothing done at startup; what it needs is RB_FIXTURE, because the
           relative fallback resolves against the module directory surefire runs in. -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine}</argLine>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
          <environmentVariables>
            <RB_FIXTURE>${project.basedir}/../../../spec/fixture.json</RB_FIXTURE>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
