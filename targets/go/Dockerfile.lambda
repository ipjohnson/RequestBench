# Host: lambda-rie for Go. The custom runtime base image carries the Runtime Interface
# Emulator, and the handler binary must be named bootstrap.
#   docker build -f targets/go/Dockerfile.lambda --build-arg TARGET=gin -t rb/go-gin .
ARG GO_VERSION=1.26
FROM golang:${GO_VERSION}-alpine AS build
ARG TARGET
WORKDIR /src
COPY targets/go/go.mod targets/go/go.sum ./
COPY targets/go/_shared ./_shared
COPY targets/go/_hosts ./_hosts
COPY targets/go/${TARGET} ./target
RUN go mod download
# gin selects its JSON codec with a build tag (gin docs/doc.md, "Build with json
# replacement"). No other target reads one.
RUN case "$TARGET" in gin) tags=sonic ;; *) tags= ;; esac && \
    CGO_ENABLED=0 go build -tags="$tags" -trimpath -ldflags="-s -w" -o /out/bootstrap ./target

FROM public.ecr.aws/lambda/provided:al2023
COPY --from=build /out/bootstrap ${LAMBDA_RUNTIME_DIR}/bootstrap
COPY spec/fixture.json /var/task/spec/fixture.json
ENV RB_FIXTURE=/var/task/spec/fixture.json RB_HOST=lambda-rie
CMD ["bootstrap"]
