# The build context is the repository root, because every Dockerfile bakes in
# spec/fixture.json. Without this it is also every dependency tree and build directory on
# the machine, which the daemon tars once per image.
.git/
results/
site/
**/__pycache__/
**/*.pyc
targets/node/node_modules/
targets/python/.venv/
# Each framework's error contract sits beside it but is read by the client, never by the
# target. Nothing in an image needs it. The same goes for a target's test suite and the
# client generated from its API description: both are held to the image, never run in it.
targets/*/*/client-exception/
targets/*/*/suite/
targets/*/*/client/
targets/rust/target/
targets/java/*/target/
