{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  // Only the frameworks' error declarations. A framework written in TypeScript compiles its own
  // source with its own settings and dependencies.
  "include": [
    "tests/**/*.ts",
    "frameworks/exceptions.ts",
    "frameworks/*/*/client-exception/**/*.ts",
    "orchestrator/**/*.ts",
    "traffic-generator/**/*.ts"
  ]
}
